.page {
  min-height: 100vh;
  padding: 0 24rpx 60rpx;
}

.tabs {
  display: flex;
  gap: 40rpx;
  padding: 24rpx 6rpx 18rpx;
  border-bottom: 1rpx solid #eee;
}

.tab {
  font-size: 30rpx;
  color: #888;
  padding-bottom: 12rpx;
}

.tab-badge {
  display: inline-block;
  min-width: 30rpx;
  height: 30rpx;
  margin-left: 8rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: #ff3b30;
  color: #fff;
  font-size: 19rpx;
  line-height: 30rpx;
  text-align: center;
  vertical-align: middle;
}

.tab.on {
  color: #111;
  font-weight: 600;
  border-bottom: 4rpx solid #ff3b30;
}

.warn {
  margin-top: 18rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: #fff7e8;
  color: #a86b12;
  font-size: 22rpx;
  line-height: 1.5;
}

.order {
  margin-top: 18rpx;
  padding: 22rpx 24rpx;
  background: #fff;
  border-radius: 18rpx;
}

.row1 {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
}

.no {
  color: #999;
}

.status {
  color: #ff9500;
  font-weight: 600;
}

.row2 {
  margin-top: 12rpx;
  font-size: 25rpx;
  color: #333;
}

.row3 {
  display: flex;
  justify-content: space-between;
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #777;
}

.summary {
  flex: 1;
  margin-right: 20rpx;
}

.total {
  color: #ff3b30;
  font-weight: 600;
}

.row4 {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #a06b20;
}

.acts {
  margin-top: 16rpx;
  text-align: right;
}

.act {
  display: inline-block;
  padding: 0 30rpx;
  height: 62rpx;
  line-height: 62rpx;
  border-radius: 999rpx;
  background: #1a1a1a;
  color: #fff;
  font-size: 24rpx;
}

.p {
  margin-top: 16rpx;
  padding: 18rpx 20rpx 14rpx;
  background: #fff;
  border-radius: 16rpx;
}

.p-top {
  display: flex;
  align-items: center;
}

.p-thumb {
  width: 84rpx;
  height: 84rpx;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.p-emoji {
  font-size: 38rpx;
}

.p-main {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}

.p-name {
  font-size: 27rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.p-price {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #ff3b30;
}

.empty {
  padding: 120rpx 0;
  text-align: center;
  color: #aaa;
  font-size: 25rpx;
}

/* ---------- 商品管理 ---------- */
.add-btn {
  margin-top: 18rpx;
  height: 84rpx;
  border-radius: 14rpx;
  background: #fff;
  border: 2rpx dashed #ff4d4f;
  color: #ff3b30;
  font-size: 27rpx;
  line-height: 84rpx;
  text-align: center;
}

.p-ops {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #f6f6f6;
}

.op {
  padding: 8rpx 26rpx;
  border-radius: 999rpx;
  background: #f5f5f5;
  font-size: 23rpx;
  color: #555;
}

.op.del {
  background: #fff1f0;
  color: #ff3b30;
}

.p-cat {
  font-size: 21rpx;
  color: #aaa;
  font-weight: 400;
}

.p-off {
  font-size: 20rpx;
  color: #bbb;
}

/* ---------- 无权限 ---------- */
.denied {
  padding: 180rpx 60rpx;
  text-align: center;
}

.denied-ico {
  font-size: 80rpx;
}

.denied-t {
  margin-top: 24rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.denied-d {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #999;
  line-height: 1.7;
}

.denied-openid {
  margin-top: 28rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  background: #f7f7f7;
  text-align: left;
}

.denied-openid-t {
  font-size: 21rpx;
  color: #999;
}

.denied-openid-v {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #333;
  word-break: break-all;
}

.denied-btn {
  display: inline-block;
  margin-top: 40rpx;
  padding: 0 56rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 999rpx;
  background: #1a1a1a;
  color: #fff;
  font-size: 27rpx;
}
