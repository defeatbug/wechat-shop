.page {
  min-height: 100vh;
  padding: 0 24rpx 60rpx;
}

.tabs {
  display: flex;
  gap: 40rpx;
  padding: 24rpx 6rpx 18rpx;
  border-bottom: 1rpx solid #eee;
}

.tab {
  font-size: 30rpx;
  color: #888;
  padding-bottom: 12rpx;
}

.tab.on {
  color: #111;
  font-weight: 600;
  border-bottom: 4rpx solid #ff3b30;
}

.warn {
  margin-top: 18rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: #fff7e8;
  color: #a86b12;
  font-size: 22rpx;
  line-height: 1.5;
}

.order {
  margin-top: 18rpx;
  padding: 22rpx 24rpx;
  background: #fff;
  border-radius: 18rpx;
}

.row1 {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
}

.no {
  color: #999;
}

.status {
  color: #ff9500;
  font-weight: 600;
}

.row2 {
  margin-top: 12rpx;
  font-size: 25rpx;
  color: #333;
}

.row3 {
  display: flex;
  justify-content: space-between;
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #777;
}

.summary {
  flex: 1;
  margin-right: 20rpx;
}

.total {
  color: #ff3b30;
  font-weight: 600;
}

.row4 {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #a06b20;
}

.acts {
  margin-top: 16rpx;
  text-align: right;
}

.act {
  display: inline-block;
  padding: 0 30rpx;
  height: 62rpx;
  line-height: 62rpx;
  border-radius: 999rpx;
  background: #1a1a1a;
  color: #fff;
  font-size: 24rpx;
}

.p {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: #fff;
  border-radius: 16rpx;
}

.p-thumb {
  width: 84rpx;
  height: 84rpx;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.p-emoji {
  font-size: 38rpx;
}

.p-main {
  flex: 1;
  margin-left: 18rpx;
}

.p-name {
  font-size: 27rpx;
}

.p-price {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #ff3b30;
}

.empty {
  padding: 120rpx 0;
  text-align: center;
  color: #aaa;
  font-size: 25rpx;
}

/* ---------- 商品管理 ---------- */
.add-btn {
  margin-top: 18rpx;
  height: 84rpx;
  border-radius: 14rpx;
  background: #fff;
  border: 2rpx dashed #ff4d4f;
  color: #ff3b30;
  font-size: 27rpx;
  line-height: 84rpx;
  text-align: center;
}

.p-ops {
  display: flex;
  align-items: center;
  margin-right: 10rpx;
}

.op {
  padding: 8rpx 16rpx;
  font-size: 23rpx;
  color: #2f8ffb;
}

.op.del {
  color: #ff3b30;
}

.p-cat {
  font-size: 21rpx;
  color: #aaa;
  font-weight: 400;
}

.p-off {
  font-size: 20rpx;
  color: #bbb;
}

/* ---------- 编辑弹层 ---------- */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s ease;
  z-index: 40;
}

.mask.show {
  opacity: 1;
  pointer-events: auto;
}

.editor {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 760rpx;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  transform: translateY(110%);
  transition: transform 0.24s ease;
  z-index: 50;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.editor.show {
  transform: translateY(0);
}

.e-head {
  position: relative;
  flex: none;
  padding: 26rpx 0 20rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  border-bottom: 1rpx solid #f4f4f4;
}

.e-close {
  position: absolute;
  right: 30rpx;
  top: 24rpx;
  color: #bbb;
  font-size: 30rpx;
}

.e-body {
  flex: 1;
  min-height: 0;
  padding: 0 30rpx;
}

.f-row {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  border-bottom: 1rpx solid #f6f6f6;
}

.f-label {
  flex: none;
  width: 170rpx;
  font-size: 26rpx;
  color: #555;
}

.f-input {
  flex: 1;
  font-size: 27rpx;
  text-align: right;
}

.f-picker {
  flex: 1;
  text-align: right;
  font-size: 27rpx;
  color: #222;
}

.arrow {
  margin-left: 8rpx;
  color: #bbb;
}

.f-switch {
  flex: 1;
  display: flex;
  justify-content: flex-end;
}

.e-tip {
  padding: 22rpx 0;
  font-size: 21rpx;
  color: #aaa;
  line-height: 1.5;
}

.e-foot {
  flex: none;
  display: flex;
  gap: 20rpx;
  padding: 16rpx 30rpx calc(30rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #f4f4f4;
}

.e-btn {
  flex: 1;
  height: 84rpx;
  border-radius: 999rpx;
  text-align: center;
  line-height: 84rpx;
  font-size: 28rpx;
}

.e-btn.ghost {
  background: #f5f5f5;
  color: #555;
}

.e-btn.primary {
  background: linear-gradient(135deg, #ff5b4f, #ff3b30);
  color: #fff;
  font-weight: 600;
}
