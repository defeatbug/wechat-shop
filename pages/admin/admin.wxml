<view class="page">
  <view class="denied" wx:if="{{denied}}">
    <view class="denied-ico">🔒</view>
    <view class="denied-t">没有访问权限</view>
    <view class="denied-d">店主后台仅管理员可用。请用店主微信打开；本地演示模式需要输入管理密码。</view>
    <view class="denied-btn" bindtap="onExitAdmin">返回</view>
  </view>

  <block wx:else>
  <view class="tabs">
    <view class="tab {{tab === 'orders' ? 'on' : ''}}" data-tab="orders" bindtap="onTab">订单</view>
    <view class="tab {{tab === 'goods' ? 'on' : ''}}" data-tab="goods" bindtap="onTab">商品</view>
  </view>

  <view class="warn" wx:if="{{isLocal}}">
    演示模式：这里的改动只保存在本机。接入云开发后，订单与商品会写入云端，所有顾客共用。
  </view>

  <block wx:if="{{tab === 'orders'}}">
    <view class="order" wx:for="{{orders}}" wx:key="_id">
      <view class="row1">
        <text class="no">{{item.no}}</text>
        <text class="status">{{item.statusText}}</text>
      </view>
      <view class="row2">{{item.contactName}} · {{item.contactPhone}} · {{item.pickup}}</view>
      <view class="row3">
        <text class="summary">{{item.summary}}</text>
        <text class="total">¥{{item.totalText}}</text>
      </view>
      <view class="row4" wx:if="{{item.remark}}">备注：{{item.remark}}</view>
      <view class="acts" wx:if="{{item.status !== 'done'}}">
        <view class="act" data-id="{{item._id}}" bindtap="onAdvance">
          {{item.status === 'pending' ? '标记已确认' : '标记已完成'}}
        </view>
      </view>
    </view>
    <view class="empty" wx:if="{{!orders.length}}">还没有订单</view>
  </block>

  <block wx:else>
    <view class="add-btn" bindtap="onAddProduct">＋ 新增商品</view>

    <view class="p" wx:for="{{products}}" wx:key="_id">
      <view class="p-top">
        <view class="p-thumb" style="background:{{item.bg}}"><text class="p-emoji">{{item.emoji}}</text></view>
        <view class="p-main">
          <view class="p-name">{{item.name}}</view>
          <view class="p-price">
            ¥{{item.priceText}}
            <text class="p-cat" wx:if="{{item.catName}}"> · {{item.catName}}</text>
            <text class="p-off" wx:if="{{item.on === false}}"> 已下架</text>
          </view>
        </view>
        <switch checked="{{item.on !== false}}" color="#ff4d4f" data-id="{{item._id}}" bindchange="onToggle" />
      </view>
      <view class="p-ops">
        <view class="op" data-id="{{item._id}}" bindtap="onEditProduct">编辑</view>
        <view class="op del" data-id="{{item._id}}" bindtap="onDeleteProduct">删除</view>
      </view>
    </view>

    <view class="empty" wx:if="{{!products.length}}">还没有商品，点上面「新增商品」</view>
  </block>
  </block>

  <!-- 新增 / 编辑 弹层 -->
  <view class="mask {{editing ? 'show' : ''}}" bindtap="closeEditor"></view>
  <view class="editor {{editing ? 'show' : ''}}">
    <view class="e-head">
      {{form._id ? '编辑商品' : '新增商品'}}
      <text class="e-close" bindtap="closeEditor">✕</text>
    </view>

    <scroll-view scroll-y class="e-body">
      <view class="f-row">
        <text class="f-label">名称</text>
        <input class="f-input" value="{{form.name}}" data-k="name" bindinput="onField" placeholder="如 珍珠耳钉" />
      </view>
      <view class="f-row">
        <text class="f-label">分类</text>
        <picker range="{{catNames}}" value="{{form.catIndex}}" bindchange="onCatChange">
          <view class="f-picker">{{catNames[form.catIndex]}}<text class="arrow">›</text></view>
        </picker>
      </view>
      <view class="f-row">
        <text class="f-label">价格（元）</text>
        <input class="f-input" type="digit" value="{{form.priceYuan}}" data-k="priceYuan" bindinput="onField" placeholder="0 表示免费款" />
      </view>
      <view class="f-row">
        <text class="f-label">描述</text>
        <input class="f-input" value="{{form.desc}}" data-k="desc" bindinput="onField" placeholder="一句话卖点" />
      </view>
      <view class="f-row">
        <text class="f-label">图标</text>
        <input class="f-input" value="{{form.emoji}}" data-k="emoji" bindinput="onField" placeholder="emoji，如 💍" />
      </view>
      <view class="f-row">
        <text class="f-label">上架</text>
        <view class="f-switch"><switch checked="{{form.on}}" color="#ff4d4f" bindchange="onSwitchOn" /></view>
      </view>
      <view class="e-tip">图片暂用 emoji 占位；接云存储后可在商品里换成实拍图。</view>
    </scroll-view>

    <view class="e-foot">
      <view class="e-btn ghost" bindtap="closeEditor">取消</view>
      <view class="e-btn primary" bindtap="onSaveProduct">保存</view>
    </view>
  </view>
</view>
