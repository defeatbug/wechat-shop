.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 220rpx;
  overflow-x: hidden;
}

.form {
  background: #fff;
  border-radius: 20rpx;
  padding: 0 24rpx;
}

.f-row {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 104rpx;
  border-bottom: 1rpx solid #f4f4f4;
  overflow: hidden;
}

.f-row:last-child {
  border-bottom: none;
}

.f-label {
  flex: none;
  width: 190rpx;
  font-size: 27rpx;
  color: #555;
}

.f-input {
  flex: 1;
  width: 0;
  min-width: 0;
  padding: 0;
  font-size: 28rpx;
  text-align: right;
  color: #1a1a1a;
}

.f-picker-wrap {
  flex: 1;
  min-width: 0;
}

.f-picker {
  font-size: 28rpx;
  text-align: right;
  color: #1a1a1a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.arrow {
  margin-left: 8rpx;
  color: #bbb;
}

.f-switch {
  flex: 1;
  min-width: 0;
  display: flex;
  justify-content: flex-end;
}

.tip {
  margin: 20rpx 6rpx 0;
  font-size: 22rpx;
  color: #aaa;
  line-height: 1.6;
}

.foot {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100vw;
  box-sizing: border-box;
  display: flex;
  gap: 20rpx;
  padding: 16rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -6rpx 24rpx rgba(0, 0, 0, 0.06);
}

.btn {
  flex: 1 1 0;
  min-width: 0;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0;
  border-radius: 999rpx;
  font-size: 29rpx;
  font-weight: 600;
}

.btn::after {
  border: none;
}

.btn.ghost {
  background: #f5f5f5;
  color: #555;
}

.btn.primary {
  background: linear-gradient(135deg, #ff5b4f, #ff3b30);
  color: #fff;
}
