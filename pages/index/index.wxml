<view class="page">
  <view class="hero">
    <view class="hero-glow"></view>
    <view class="hero-row">
      <view class="avatar"><text class="avatar-emoji">🐻</text></view>
      <view class="shop-meta" bindtap="onShopInfo">
        <view class="shop-name">{{shop.name}}</view>
        <view class="shop-sub">选款下单 · 免配送费</view>
      </view>
    </view>
  </view>

  <view class="sheet">
    <view class="sheet-title">下单</view>
    <view class="sheet-line"></view>

    <view class="sheet-tools">
      <text class="free">免配送费</text>
      <view class="tools-right">
        <view class="orders-link" bindtap="goSearch">
          <text class="orders-ico">🔍</text>
          <text>搜索</text>
        </view>
        <view class="orders-link" bindtap="goOrders">
          <text class="orders-ico">🧾</text>
          <text>我的订单</text>
        </view>
      </view>
    </view>

    <view class="body">
      <scroll-view class="cats" scroll-y enhanced show-scrollbar="{{false}}">
        <view
          wx:for="{{groups}}"
          wx:key="id"
          class="cat {{activeCat === item.id ? 'on' : ''}}"
          data-id="{{item.id}}"
          bindtap="onCatTap"
        >
          <text>{{item.name}}{{item.emoji}}</text>
        </view>
      </scroll-view>

      <scroll-view
        class="goods"
        scroll-y
        scroll-with-animation
        scroll-into-view="{{anchor}}"
        bindscroll="onGoodsScroll"
        enhanced
        show-scrollbar="{{false}}"
      >
        <view wx:for="{{groups}}" wx:key="id" class="group" id="cat-{{item.id}}">
          <view class="group-title">{{item.name}}{{item.emoji}}</view>

          <view class="card" wx:for="{{item.products}}" wx:for-item="p" wx:key="_id">
            <view class="thumb" style="background:{{p.bg}}">
              <text class="thumb-emoji">{{p.emoji}}</text>
              <view class="free-tag" wx:if="{{p.price === 0}}">0元</view>
            </view>
            <view class="info">
              <view class="name">{{p.name}}</view>
              <view class="desc">{{p.desc}}</view>
              <view class="row">
                <view class="price">
                  <text class="sym">¥</text>
                  <text class="num">{{p.priceText}}</text>
                </view>
                <view class="plus" catchtap="onAdd" data-id="{{p._id}}">＋</view>
              </view>
            </view>
          </view>
        </view>
        <view class="goods-foot">— 已经到底啦 —</view>
      </scroll-view>
    </view>
  </view>

  <view class="shop-mask {{shopOpen ? 'show' : ''}}" bindtap="closeShopInfo"></view>
  <view class="shop-panel {{shopOpen ? 'show' : ''}}">
    <view class="sp-close" bindtap="closeShopInfo">✕</view>
    <view class="sp-avatar">{{shop.avatar}}</view>
    <view class="sp-name">{{shop.name}}</view>
    <view class="sp-desc">{{shop.notice}}</view>
    <view class="sp-row" bindtap="onCall">
      <text class="sp-ico">📞</text>
      <text class="sp-val">{{shop.phone}}</text>
      <text class="sp-arrow">›</text>
    </view>
    <view class="sp-row" bindtap="onCopyAddr">
      <text class="sp-ico">📍</text>
      <text class="sp-val">{{shop.address}}</text>
      <text class="sp-arrow">›</text>
    </view>
    <view class="sp-row">
      <text class="sp-ico">🕙</text>
      <text class="sp-val">{{shop.hours}}</text>
    </view>
    <view class="sp-row">
      <text class="sp-ico">💬</text>
      <text class="sp-val">{{shop.wechat}}</text>
    </view>
  </view>

  <view class="cartbar {{count > 0 ? 'show' : ''}}">
    <view class="cart-left" bindtap="goCart">
      <view class="cart-ico">
        🛒
        <view class="badge">{{count}}</view>
      </view>
      <view class="cart-total">
        <view class="cart-count">已选 {{count}} 件</view>
        <view class="cart-money"><text class="sym">¥</text>{{totalText}}</view>
      </view>
    </view>
    <view class="cart-go" bindtap="goCart">去确认</view>
  </view>
</view>
