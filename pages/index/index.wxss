.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
}

/* ---------- 顶部封面 ---------- */
.hero {
  position: relative;
  flex: none;
  height: 240rpx;
  background: linear-gradient(135deg, #e9d8d2 0%, #cbb9c4 38%, #a8a7bd 68%, #8d96ad 100%);
  overflow: hidden;
}

.hero-glow {
  position: absolute;
  right: -80rpx;
  top: -120rpx;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.28);
  filter: blur(20rpx);
}

.hero-row {
  position: absolute;
  left: 36rpx;
  bottom: 60rpx;
  display: flex;
  align-items: center;
}

.avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: #fdf8f2;
  border: 4rpx solid rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.12);
}

.avatar-emoji {
  font-size: 54rpx;
}

.shop-meta {
  margin-left: 20rpx;
  color: #fff;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.18);
}

.shop-name {
  font-size: 38rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.shop-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  opacity: 0.9;
}

/* ---------- 下单面板 ---------- */
.sheet {
  position: relative;
  flex: 1;
  min-height: 0;
  margin-top: -28rpx;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  display: flex;
  flex-direction: column;
  z-index: 2;
}

.sheet-title {
  padding-top: 26rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #111;
}

.sheet-line {
  width: 76rpx;
  height: 6rpx;
  margin: 14rpx auto 0;
  border-radius: 4rpx;
  background: #222;
}

.sheet-tools {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 30rpx 18rpx;
}

.free {
  font-size: 26rpx;
  color: #666;
}

.orders-link {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #444;
}

.orders-ico {
  margin-right: 8rpx;
  font-size: 28rpx;
}

/* ---------- 左右分栏 ---------- */
.body {
  flex: 1;
  min-height: 0;
  display: flex;
}

.cats {
  flex: none;
  width: 178rpx;
  height: 100%;
  background: #f6f6f6;
}

.cat {
  position: relative;
  min-height: 104rpx;
  padding: 0 18rpx;
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #7a7a7a;
  line-height: 1.3;
}

.cat.on {
  background: #fff;
  color: #1a1a1a;
  font-weight: 600;
}

.cat.on::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 36rpx;
  border-radius: 0 6rpx 6rpx 0;
  background: #ff3b30;
}

.goods {
  flex: 1;
  height: 100%;
  padding: 0 22rpx;
}

.group-title {
  padding: 22rpx 0 10rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #111;
}

.card {
  display: flex;
  padding: 18rpx 0 22rpx;
  border-bottom: 1rpx solid #f4f4f4;
}

.card:last-child {
  border-bottom: none;
}

.thumb {
  position: relative;
  flex: none;
  width: 168rpx;
  height: 168rpx;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.thumb-emoji {
  font-size: 64rpx;
}

.free-tag {
  position: absolute;
  left: 0;
  top: 0;
  padding: 2rpx 12rpx;
  border-radius: 10rpx 0 10rpx 0;
  background: rgba(255, 59, 48, 0.92);
  color: #fff;
  font-size: 20rpx;
}

.info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 4rpx 0;
}

.name {
  font-size: 30rpx;
  font-weight: 500;
  color: #1a1a1a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9a9a9a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.price {
  color: #ff3b30;
  display: flex;
  align-items: baseline;
}

.price .sym {
  font-size: 24rpx;
  font-weight: 600;
}

.price .num {
  font-size: 34rpx;
  font-weight: 700;
  margin-left: 2rpx;
}

.plus {
  width: 52rpx;
  height: 52rpx;
  border-radius: 12rpx;
  background: #ff4d4f;
  color: #fff;
  font-size: 40rpx;
  line-height: 48rpx;
  text-align: center;
  box-shadow: 0 4rpx 10rpx rgba(255, 77, 79, 0.35);
}

.plus:active {
  transform: scale(0.92);
}

.goods-foot {
  padding: 30rpx 0 170rpx;
  text-align: center;
  font-size: 22rpx;
  color: #c4c4c4;
}

/* ---------- 底部结算条 ---------- */
.cartbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 116rpx;
  padding: 0 24rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 -6rpx 24rpx rgba(0, 0, 0, 0.08);
  transform: translateY(140%);
  transition: transform 0.24s ease;
  z-index: 10;
}

.cartbar.show {
  transform: translateY(0);
}

.cart-left {
  display: flex;
  align-items: center;
}

.cart-ico {
  position: relative;
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: #f7f7f7;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.badge {
  position: absolute;
  top: -4rpx;
  right: -6rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: #ff3b30;
  color: #fff;
  font-size: 20rpx;
  line-height: 32rpx;
  text-align: center;
}

.cart-total {
  margin-left: 20rpx;
}

.cart-count {
  font-size: 22rpx;
  color: #999;
}

.cart-money {
  font-size: 36rpx;
  font-weight: 700;
  color: #ff3b30;
  line-height: 1.2;
}

.cart-money .sym {
  font-size: 24rpx;
  margin-right: 2rpx;
}

.cart-go {
  height: 84rpx;
  padding: 0 52rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ff5b4f, #ff3b30);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 84rpx;
  box-shadow: 0 8rpx 18rpx rgba(255, 59, 48, 0.3);
}
