.page {
  min-height: 100vh;
  padding: 20rpx 24rpx 60rpx;
}

.hint {
  margin-bottom: 18rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: #eef6ff;
  color: #3d6fa8;
  font-size: 22rpx;
  line-height: 1.5;
}

.order {
  margin-bottom: 20rpx;
  padding: 22rpx 24rpx;
  background: #fff;
  border-radius: 20rpx;
}

.o-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f4f4f4;
}

.o-no {
  font-size: 22rpx;
  color: #999;
}

.o-status {
  font-size: 24rpx;
  font-weight: 600;
}

.s-pending {
  color: #ff9500;
}

.s-confirmed {
  color: #2f8ffb;
}

.s-done {
  color: #34c759;
}

.s-canceled {
  color: #bbb;
}

.o-item {
  display: flex;
  justify-content: space-between;
  padding-top: 16rpx;
  font-size: 26rpx;
  color: #333;
}

.o-name {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.o-price {
  margin-left: 20rpx;
  color: #666;
}

.o-contact {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #888;
}

.o-remark {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #a06b20;
  background: #fffaf0;
  border-radius: 10rpx;
  padding: 10rpx 14rpx;
}

.o-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f4f4f4;
}

.o-time {
  font-size: 21rpx;
  color: #aaa;
}

.o-total {
  font-size: 26rpx;
  font-weight: 600;
  color: #ff3b30;
}

.empty {
  padding: 160rpx 0;
  text-align: center;
  color: #999;
  font-size: 26rpx;
}

.empty-btn {
  display: inline-block;
  margin-top: 30rpx;
  padding: 0 44rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 999rpx;
  background: #ff4d4f;
  color: #fff;
  font-size: 28rpx;
}

.admin-link {
  margin-top: 40rpx;
  text-align: center;
  font-size: 22rpx;
  color: #bbb;
}
