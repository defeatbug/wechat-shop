.page {
  min-height: 100vh;
  padding: 20rpx 24rpx 200rpx;
}

.tip {
  padding: 18rpx 22rpx;
  margin-bottom: 20rpx;
  border-radius: 14rpx;
  background: #fff7e8;
  color: #a86b12;
  font-size: 23rpx;
  line-height: 1.5;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 6rpx 22rpx;
}

.line {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f4f4f4;
}

.line:last-child {
  border-bottom: none;
}

.thumb {
  flex: none;
  width: 108rpx;
  height: 108rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.thumb-emoji {
  font-size: 46rpx;
}

.line-main {
  flex: 1;
  min-width: 0;
  margin: 0 18rpx;
}

.line-name {
  font-size: 28rpx;
  color: #1a1a1a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.line-price {
  margin-top: 8rpx;
  color: #ff3b30;
  font-size: 30rpx;
  font-weight: 600;
}

.line-price .sym {
  font-size: 22rpx;
}

.stepper {
  display: flex;
  align-items: center;
}

.st-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #f4f4f4;
  color: #333;
  font-size: 34rpx;
  line-height: 48rpx;
  text-align: center;
}

.st-plus {
  background: #ff4d4f;
  color: #fff;
}

.st-num {
  min-width: 56rpx;
  text-align: center;
  font-size: 28rpx;
}

.empty {
  padding: 140rpx 0;
  text-align: center;
  color: #999;
  font-size: 26rpx;
}

.empty-btn {
  display: inline-block;
  margin-top: 30rpx;
  padding: 0 44rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 999rpx;
  background: #ff4d4f;
  color: #fff;
  font-size: 28rpx;
}

.form {
  margin-top: 20rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 4rpx 22rpx;
}

.f-row {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  border-bottom: 1rpx solid #f4f4f4;
}

.f-row:last-child {
  border-bottom: none;
}

.f-col {
  flex-direction: column;
  align-items: stretch;
  padding: 22rpx 0;
}

.f-label {
  flex: none;
  width: 150rpx;
  font-size: 27rpx;
  color: #555;
}

.f-input {
  flex: 1;
  font-size: 27rpx;
  text-align: right;
}

.f-picker {
  flex: 1;
  text-align: right;
  font-size: 27rpx;
  color: #333;
}

.arrow {
  margin-left: 10rpx;
  color: #bbb;
}

.f-textarea {
  width: 100%;
  min-height: 110rpx;
  margin-top: 12rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: #f8f8f8;
  font-size: 25rpx;
  line-height: 1.6;
}

.footbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 118rpx;
  padding: 0 24rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: #fff;
  box-shadow: 0 -6rpx 24rpx rgba(0, 0, 0, 0.08);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.foot-count {
  font-size: 22rpx;
  color: #999;
}

.foot-money {
  font-size: 36rpx;
  font-weight: 700;
  color: #ff3b30;
  line-height: 1.2;
}

.foot-money .sym {
  font-size: 24rpx;
}

.foot-btn {
  height: 84rpx;
  padding: 0 56rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ff5b4f, #ff3b30);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 84rpx;
  box-shadow: 0 8rpx 18rpx rgba(255, 59, 48, 0.3);
}

.foot-btn.disabled {
  opacity: 0.6;
}
